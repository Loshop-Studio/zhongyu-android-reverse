        <action android:id="@id/action_homeFragment_to_myCourseDetailsFragment" app:destination="@id/myCourseDetailsFragment" app:launchSingleTop="true">
            <argument android:name="myCourse" app:argType="com.zykj.study.data.MyCourseEntity" app:nullable="false" />
        </action>
        <action android:id="@id/action_homeFragment_to_searchFragment" app:destination="@id/searchFragment" app:launchSingleTop="true" />
        <action android:id="@id/action_homeFragment_to_courseDetailsFragment" app:destination="@id/courseDetailsFragment" app:launchSingleTop="true" />
        <action android:id="@id/action_homeFragment_to_nav_qr_code" app:destination="@id/nav_qr_code" app:launchSingleTop="true" />
        <action android:id="@id/action_homeFragment_to_microCodeFragment" app:destination="@id/microCodeFragment" app:launchSingleTop="true" />
        <action android:id="@id/action_homeFragment_to_courseContentFragment" app:destination="@id/courseContentFragment" app:launchSingleTop="true" />
