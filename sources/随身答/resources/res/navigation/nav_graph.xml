<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/nav_graph" app:startDestination="@id/home_fragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:name="com.zykj.student.dialogue.ui.home.HomeFragment" android:id="@id/home_fragment">
        <action android:id="@id/actionHomeFragmentToAskQuestionDialog" app:destination="@id/ask_question_dialog" />
    </fragment>
    <dialog android:name="com.zykj.student.dialogue.ui.home.DatePickerFragment" android:id="@id/date_picker_fragment">
        <argument android:name="startDate" app:argType="java.util.Date" app:nullable="true" />
        <argument android:name="endDate" app:argType="java.util.Date" app:nullable="true" />
        <argument android:name="startTime" app:argType="java.util.Date" app:nullable="true" />
        <argument android:name="endTime" app:argType="java.util.Date" app:nullable="true" />
        <argument android:name="isJoinedTime" android:defaultValue="true" app:argType="boolean" />
        <argument android:name="type" app:argType="integer" />
    </dialog>
    <include app:graph="@navigation/nav_graph_detail" />
    <dialog android:name="com.zykj.student.dialogue.ui.home.category.EditDialogFragment" android:id="@id/edit_category_dialog_fragment">
        <argument android:name="categoryList" app:argType="com.zykj.student.dialogue.bean.resp.CatalogResp[]" />
    </dialog>
    <include app:graph="@navigation/nav_graph_create_answer" />
    <dialog android:name="com.zykj.student.dialogue.ui.ask.AskQuestionDialogFragment" android:id="@id/ask_question_dialog">
        <argument android:name="quoraSearchEnable" android:defaultValue="true" app:argType="boolean" />
    </dialog>
    <fragment android:name="com.zykj.student.dialogue.ui.collect.SearchedQuestionFragment" android:id="@id/searchedQuestionFragment">
        <argument android:name="imagePath" app:argType="string" />
    </fragment>
    <fragment android:name="com.zykj.student.dialogue.ui.collect.CollectHistoryFragment" android:id="@id/collectHistoryFragment" />
    <fragment android:name="com.zykj.student.dialogue.ui.ask.AskDescriptionFragment" android:id="@id/askDescriptionFragment">
        <deepLink app:action="com.zykj.dialogue.ask" app:mimeType="share/file" app:uri="http://www.zykj.dialogue.ask/" />
        <argument android:name="imagePath" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>
</navigation>
